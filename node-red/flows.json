        "func": "const parts = msg.topic.split(\"/\");\n\n// factory/machine02/maintenance\nconst machineId = parts[parts.length - 2];\n\nmsg.params = [\n    machineId,\n    msg.payload,\n    \"Maintenance performed - machine reset\"\n];\n\nreturn msg;",
