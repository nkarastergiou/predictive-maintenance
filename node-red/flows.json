    {
        "id": "82d33ffaaf0bef4f",
        "type": "function",
        "z": "b2c61c7f661953be",
        "name": "Aggregate Machine Reading",
        "func": "const machineId = msg.machine_id;\nconst sensorType = msg.topic;\n\nlet machines = context.get(\"machines\") || {};\n\nif (!machines[machineId]) {\n    machines[machineId] = {};\n}\n\nmachines[machineId][sensorType] = msg.payload;\n\ncontext.set(\"machines\", machines);\n\nconst data = machines[machineId];\n\n// Περιμένουμε να έχουμε πλήρες reading\nif (\n    data.temperature === undefined ||\n    data.vibration === undefined ||\n    data.current === undefined ||\n    data.status === undefined\n) {\n    return null;\n}\n\n// Το simulator στέλνει:\n// temperature → vibration → current → status\n// Άρα εκπέμπουμε μόνο όταν φτάσει το status.\nif (sensorType !== \"status\") {\n    return null;\n}\n\nmsg.payload = {\n    machine_id: machineId,\n    temperature: Number(data.temperature),\n    vibration: Number(data.vibration),\n    current: Number(data.current),\n    status: data.status\n};\n\nreturn msg;",
        "outputs": 1,
