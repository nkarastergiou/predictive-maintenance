        "name": "Filter New ML Failure Event",
        "func": "const machineId =\n    msg.machine_id ||\n    msg.payload?.machine_id ||\n    \"unknown\";\n\nconst currentPrediction = msg.payload?.predicted_status;\n\n// Αποθηκεύουμε προηγούμενη predictive κατάσταση ανά machine\nlet states = context.get(\"ml_states\") || {};\n\nconst previousPrediction = states[machineId];\n\n// Ενημερώνουμε state\nstates[machineId] = currentPrediction;\ncontext.set(\"ml_states\", states);\n\n// Alert μόνο όταν ΜΠΑΙΝΟΥΜΕ σε FAILURE RISK\nif (\n    currentPrediction === \"FAILURE RISK\" &&\n    previousPrediction !== \"FAILURE RISK\"\n) {\n    return msg;\n}\n\nreturn null;",
