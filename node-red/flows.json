    {
        "id": "3f7bf71abaeb7f87",
        "type": "function",
        "z": "b2c61c7f661953be",
        "name": "Prepare Predictive Features",
        "func": "const machineId =\n    msg.payload.machine_id ||\n    msg.machine_id;\n\nif (!machineId) {\n    node.warn(\"Missing machine_id\");\n    return null;\n}\n\nconst currentStatus = msg.payload.status;\n\n// Παίρνουμε ξεχωριστό history για κάθε machine\nlet allHistory = context.get(\"sensorHistoryByMachine\") || {};\n\nlet history = allHistory[machineId] || [];\n\nhistory.push({\n    temperature: Number(msg.payload.temperature),\n    vibration: Number(msg.payload.vibration),\n    current: Number(msg.payload.current)\n});\n\n// Κρατάμε μόνο τα τελευταία 11 readings\nif (history.length > 11) {\n    history.shift();\n}\n\n// Αποθηκεύουμε το history του συγκεκριμένου machine\nallHistory[machineId] = history;\ncontext.set(\"sensorHistoryByMachine\", allHistory);\n\n// Κρατάμε πληροφορίες που θα χρειαστούν μετά\nmsg.machine_id = machineId;\nmsg.originalStatus = currentStatus;\n\n// Δεν έχουμε αρκετό history ακόμα\nif (history.length < 11) {\n    return null;\n}\n\nconst currentReading = history[history.length - 1];\n\n// Τα προηγούμενα 10 readings\nconst past = history.slice(0, 10);\n\nconst tempAvg =\n    past.reduce((sum, r) => sum + r.temperature, 0) / 10;\n\nconst vibrationAvg =\n    past.reduce((sum, r) => sum + r.vibration, 0) / 10;\n\nconst currentAvg =\n    past.reduce((sum, r) => sum + r.current, 0) / 10;\n\nmsg.payload = {\n    temperature: currentReading.temperature,\n    vibration: currentReading.vibration,\n    current: currentReading.current,\n\n    temp_change_10:\n        currentReading.temperature - past[0].temperature,\n\n    vibration_change_10:\n        currentReading.vibration - past[0].vibration,\n\n    current_change_10:\n        currentReading.current - past[0].current,\n\n    temp_avg_10: tempAvg,\n    vibration_avg_10: vibrationAvg,\n    current_avg_10: currentAvg,\n\n    current_status: currentStatus\n};\n\n// Κρατάμε αντίγραφο για χρήση μετά το HTTP request\nmsg.predictiveFeatures = { ...msg.payload };\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 260,
        "wires": [
