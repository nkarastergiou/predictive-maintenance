        "func": "const response = msg.payload;\n\nmsg.payload = {\n    machine_id: msg.machine_id,\n\n    temperature: msg.predictiveFeatures.temperature,\n    vibration: msg.predictiveFeatures.vibration,\n    current: msg.predictiveFeatures.current,\n\n    current_status: msg.originalStatus,\n\n    future_failure: response.future_failure,\n    failure_probability: response.failure_probability,\n    predictive_state: response.predictive_state,\n\n    health_score: response.maintenance.health_score,\n    maintenance_priority:\n        response.maintenance.maintenance_priority,\n\n    risk_driver:\n        response.maintenance.risk_driver,\n\n    recommended_action:\n        response.maintenance.recommended_action\n};\n\nreturn msg;",
